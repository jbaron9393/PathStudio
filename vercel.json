{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "cap_cloze_refiner.html",
          "cap_synoptic_generator.html",
          "script.js",
          "favicon.svg",
          "data/style_seed.json"
        ]
      }
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "cap_synoptic_generator.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/cap_synoptic_generator.html",
      "dest": "/cap_synoptic_generator.html"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
