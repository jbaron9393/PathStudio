# Copy this file to .env for local development.
# Do not paste real secrets into .env.example.

# Option A: point the app at a local file containing your OpenAI API key.
# Windows paths are safest with forward slashes in .env files.
OPENAI_API_KEY_FILE=C:/Users/jspcb/OneDrive - The University of Colorado Denver/Documents/GitHub/API.txt

# Option B: paste the key directly into .env instead of using OPENAI_API_KEY_FILE.
# OPENAI_API_KEY=sk-your-key-here

# Optional: set a local login/password gate for the app. Leave blank to disable.
APP_USERNAME=
